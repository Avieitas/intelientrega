# Copie para .env (NÃO versionado) e use: supabase secrets set --env-file backend/supabase/functions/.env
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetadas automaticamente pelo Supabase.

# sandbox | production  (o servidor recusa misturar credencial TEST- com production)
MP_ENV=sandbox
# Access Token do Mercado Pago (Suas integrações > sua aplicação > Credenciais). Em sandbox começa com TEST-
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# Página https para onde o comprador volta após o checkout (ex.: backend/retorno publicada na Vercel)
MP_BACK_URL=
# Só sandbox: e-mail do usuário comprador de teste do MP (usado como payer_email)
MP_TEST_PAYER_EMAIL=
# Chave PRIVADA do comprovante de acesso: PKCS#8 DER em base64, numa linha (ver README)
ENTITLEMENT_PRIVATE_KEY=
# Opcional: preço em centavos (padrão 2000 = R$ 20,00)
# SUBSCRIPTION_PRICE_CENTS=2000
